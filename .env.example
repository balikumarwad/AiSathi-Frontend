# --- Upstream (we pay this, in USD) ---
OPENROUTER_API_KEY=sk-or-v1-your_key

# --- Supabase (paste from your project: Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gateway config ---
# Dev bypass key: lets you call the gateway before Supabase is wired up.
# Remove in production.
NEPALAI_DEV_KEY=np-dev-change-me
NEPALAI_FX_NPR_PER_USD=140
NEPALAI_MARGIN=1.25
NEPALAI_SITE_URL=http://localhost:3000

# --- Khalti (KPG-2). Sandbox: get a test secret key from dev.khalti.com ---
KHALTI_SECRET_KEY=
# sandbox (default): https://dev.khalti.com/api/v2   production: https://khalti.com/api/v2
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# --- Stripe (international rail). Test keys from dashboard.stripe.com ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Reconciliation cron auth ---
CRON_SECRET=random-string
